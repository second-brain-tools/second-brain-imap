# Settings for a source checkout: copy to .env (git-ignored), which `second-brain-imap` reads only
# when it runs from this checkout. An installed copy reads no .env: give it --env-file.
# Every variable: docs/configuration.md.

# ── The mailbox ───────────────────────────────────────────────────────────────
# Defaults are Proton Mail Bridge on this machine: 127.0.0.1, port 1143, STARTTLS.
# SBI_IMAP_HOST=127.0.0.1
# SBI_IMAP_PORT=1143
# SBI_IMAP_SECURITY=starttls        # or tls (TLS from the first byte, usually port 993)

# For Bridge: your Proton address, and the password Bridge shows in its window
# (the account's mailbox details). Not your Proton password.
SBI_IMAP_USERNAME=
SBI_IMAP_PASSWORD=

# The one certificate to trust, instead of the system's certificate authorities.
# Needed for Bridge, whose certificate is self-signed: `second-brain-imap pin-cert`
# writes this file.
# A full path: `~` is not expanded in this file.
SBI_IMAP_TLS_CERT=/home/you/.config/second-brain-imap/imap-cert.pem

# ── What a client may see (docs/configuration.md § Folders) ───────────────────
# Mailbox names as `second-brain-imap folders` prints them, comma-separated.
# SBI_FOLDERS=INBOX,Folders/Receipts        # only these can be opened
# SBI_EXCLUDE_FOLDERS=Labels/Private        # hidden, and their mail withheld everywhere
# SBI_HIDE_SPAM_AND_TRASH=true              # false shows Spam and Trash

# ── HTTP mode (docs/remote-access.md) ─────────────────────────────────────────
# SBI_TRANSPORT=http
# SBI_PUBLIC_URL=https://mail.example.com
# SBI_GITHUB_CLIENT_ID=
# SBI_GITHUB_CLIENT_SECRET=
# SBI_JWT_SIGNING_KEY=                      # openssl rand -base64 32
# SBI_ALLOWED_GITHUB_IDS=                   # numeric ids: https://api.github.com/users/<login>
